# Opt-in isolated feasibility profile: no desktop TLS, sockets or dynamic providers.
find_package(Threads REQUIRED)
add_library(LuiMobileCore STATIC ${LuiRuntimeSources} ${LuiProjectSources}
    runtime/project/HashPortable.cpp runtime/reflection/Schema.cpp runtime/presentation/Frames.cpp
    backends/mobile/Unavailable.cpp backends/mobile/Host.cpp backends/mobile/Storage.cpp
    runtime/services/Domain.cpp runtime/services/Runtime.cpp
    runtime/services/Storage.cpp runtime/services/StorageFiles.cpp)
target_include_directories(LuiMobileCore PUBLIC native/abi)
target_link_libraries(LuiMobileCore PRIVATE Luau.Compiler Luau.VM nlohmann_json::nlohmann_json Threads::Threads ${CMAKE_DL_LIBS})
target_compile_definitions(LuiMobileCore PRIVATE LUI_BUILD LUI_CAPTURED_ONLY
    LUI_PROJECT_LUAU_REVISION="${LuiLuauRevision}")
if(ANDROID)
    add_library(LuiMobileJni SHARED backends/android/Jni.cpp)
    target_link_libraries(LuiMobileJni PRIVATE LuiMobileCore nlohmann_json::nlohmann_json)
else()
    target_compile_definitions(LuiMobileCore PRIVATE LUI_STATIC_NATIVE_HOST)
    enable_testing()
    add_executable(LuiMobileHostTests tests/mobile/Host.cpp)
    target_compile_definitions(LuiMobileHostTests PRIVATE LUI_MOBILE_FIXTURE="${CMAKE_SOURCE_DIR}/tests/mobile/fixture")
    target_link_libraries(LuiMobileHostTests PRIVATE LuiMobileCore nlohmann_json::nlohmann_json Threads::Threads)
    add_test(NAME LuiMobileHostTests COMMAND LuiMobileHostTests)
    add_executable(LuiMobileSchedulerTests tests/mobile/Scheduler.cpp)
    target_link_libraries(LuiMobileSchedulerTests PRIVATE LuiMobileCore nlohmann_json::nlohmann_json Threads::Threads)
    add_test(NAME LuiMobileSchedulerTests COMMAND LuiMobileSchedulerTests)
    foreach(Suite Storage Domain)
        add_executable(LuiMobile${Suite}Tests tests/services/${Suite}.cpp)
        target_link_libraries(LuiMobile${Suite}Tests PRIVATE LuiMobileCore nlohmann_json::nlohmann_json Threads::Threads)
        add_test(NAME LuiMobile${Suite}Tests COMMAND LuiMobile${Suite}Tests)
    endforeach()
    add_executable(LuiMobilePersistenceTests tests/mobile/Persistence.cpp)
    target_compile_definitions(LuiMobilePersistenceTests PRIVATE LUI_MOBILE_CONTROLS="${CMAKE_SOURCE_DIR}/tests/mobile/controls")
    target_link_libraries(LuiMobilePersistenceTests PRIVATE LuiMobileCore nlohmann_json::nlohmann_json Threads::Threads)
    add_test(NAME LuiMobilePersistenceTests COMMAND LuiMobilePersistenceTests)
    add_executable(LuiMobileStorageFilesTests tests/services/StorageFiles.cpp)
    target_link_libraries(LuiMobileStorageFilesTests PRIVATE LuiMobileCore Threads::Threads)
    add_test(NAME LuiMobileStorageFilesTests COMMAND LuiMobileStorageFilesTests)
    add_executable(LuiMobileWorkloadTests tests/mobile/Workloads.cpp)
    target_link_libraries(LuiMobileWorkloadTests PRIVATE LuiMobileCore nlohmann_json::nlohmann_json Threads::Threads)
    add_test(NAME LuiMobileWorkloadTests COMMAND LuiMobileWorkloadTests)
endif()
