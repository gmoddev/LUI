--!strict
local Binary = require("@Binary/Binary")
local Out = Binary.Writer()
Out.U8(1)
Out.U16(0x1234)
Out.U32(0x89abcdef)
Out.Bytes("\0\255")
local First = Out.Finish()
assert(First == "\1\52\18\239\205\171\137\2\0\0\255")
Out.Bytes("")
assert(First ~= Out.Finish())
local R = Binary.Reader(Out.Finish())
assert(R.U8() == 1 and R.U16() == 0x1234 and R.U32() == 0x89abcdef and R.Bytes() == "\0\255")
assert(R.Bytes() == "" and R.Remaining() == 0 and not pcall(R.U8))
local Bad = Binary.Reader("\3\0x")
assert(not pcall(Bad.Bytes) and Bad.Remaining() == 3 and Bad.U16() == 3)
local Full = Binary.Writer(3)
Full.U8(255)
assert(not pcall(Full.Bytes, "X") and Full.Finish() == "\255")
Full.U16(65535)
assert(Full.Finish() == "\255\255\255" and not pcall(Full.U8, 0))
local Empty = Binary.Writer(0)
assert(Empty.Finish() == "" and not pcall(Empty.U16, 0))
for _, Number in {-1, 1.5, 4294967296, math.huge, 0/0} do assert(not pcall(Out.U32, Number)) end
for _, Maximum in {-1, 65537, 0/0} do assert(not pcall(Binary.Writer, Maximum)) end
local Large = Binary.Writer()
Large.Bytes(string.rep("q", 65534))
assert(#Large.Finish() == 65536 and #Binary.Reader(Large.Finish()).Bytes() == 65534)
assert(not pcall(Binary.Reader, string.rep("x", 65537)))
