--!strict
local Workspace = require('@LuiWorkbench/Workspace')
local Split = require('@LuiWorkbench/Split')
local Model = Workspace.New()
Model:Add('One'); Model:Add('Two'); Model:Add('Three', 'Right')
Model:Dock('Two', 'Right', 1)
local Saved = Model:Snapshot()
assert(Saved.Right[1] == 'Two' and Saved.ActiveRight == 'Two')
Model:Dock('Two', 'Left'); Model:SetRatio(0.8)
assert(Model:Restore(Saved) and Model:Snapshot().Ratio == 0.5)
assert(not pcall(function() Saved.Left[1] = 'tamper' end))
local Invalid: any = {Version = 1, Left = {'One'}, Right = {'Two', 'Two'}, ActiveLeft = 'One', ActiveRight = 'Two', Ratio = 0.5}
assert(not Model:Restore(Invalid) and Model:Snapshot().Right[2] == 'Three')
Invalid.Right = {'Two', 'Unknown'}; assert(not Model:Restore(Invalid))
Invalid.Right = {'Two', 'Three'}; Invalid.ActiveRight = 'One'; assert(not Model:Restore(Invalid))
Invalid.ActiveRight = 'Three'; Invalid.Ratio = 0 / 0; assert(not Model:Restore(Invalid))
Invalid.Ratio = 0.5; Invalid.Left = {[1] = 'One', Extra = 'bad'}; assert(not Model:Restore(Invalid))
Invalid.Left = {'One'}; Invalid.Path = '/private'; assert(not Model:Restore(Invalid))
assert(not Model:Restore(setmetatable({}, {__index = Saved})))
local Encoded = Model:Encode()
Model:SetRatio(0.7)
assert(Model:Decode(Encoded) and Model:Snapshot().Ratio == 0.5)
for Size = 0, #Encoded - 1 do assert(not Model:Decode(string.sub(Encoded, 1, Size))) end
assert(not Model:Decode(Encoded .. 'trailing') and not Model:Decode(string.rep('x', 8193)))
assert(Model:Snapshot().Right[1] == 'Two' and Model:Snapshot().Ratio == 0.5)
assert(not pcall(function() Model:Dock('Two', 'Left', 0) end))
assert(Model:Snapshot().Right[1] == 'Two')
local Left, Right, Wide = Model:Layout(800)
assert(Wide and Left == 396 and Right == 396)
Left, Right, Wide = Model:Layout(400); assert(not Wide and Left == 400 and Right == 0)
assert(not pcall(function() Model:Layout(math.huge) end))
local Divider = Split.New()
local Input: any = {Device = 'Mouse', Button = 'Right', PointerId = 1, IsCanceled = false}
assert(not Divider:Begin(Input, 100, 800, 0.5))
Input.Button = 'Left'; assert(Divider:Begin(Input, 100, 800, 0.5))
Input.PointerId = 2; assert(Divider:Move(Input, 300, 800) == nil)
Input.PointerId = 1; assert((Divider:Move(Input, 179.2, 800) :: number) > 0.59)
Input.Button = 'Right'; assert(Divider:Finish(Input) == nil)
Input.Button = 'Left'; Input.IsCanceled = true; assert(Divider:Finish(Input) == 0.5)
Input.IsCanceled = false; assert(Divider:Begin(Input, 100, 800, 0.5))
assert(Divider:Move(Input, 300, 900) == 0.5 and Divider:Finish(Input) == nil)
assert(Divider:Begin(Input, 100, 800, 0.1))
assert((Divider:Move(Input, 200, 800) :: number) > 0.4 and Divider:Cancel() == 0.1)
assert(Divider:Begin(Input, 100, 800, 0.5)); Divider:Dispose(); Divider:Dispose()
assert(Divider:Move(Input, 150, 800) == nil and not Divider:Begin(Input, 0, 800, 0.5))
assert(Model:Remove('Three') and not Model:Remove('Three'))
assert(not Model:Restore(Saved))
Model:Dispose(); Model:Dispose()
assert(not pcall(function() Model:Add('late') end))
print('[LUI:LibraryTest] Workspace: dock identity, atomic restore, logical geometry and canceled pointer gestures passed')
