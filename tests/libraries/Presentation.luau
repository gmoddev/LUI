--!strict
local Presentation = require("@LuiWorkbench/Presentation")
local Window = Instance.new("Window",{Visible=false})
local Root = Instance.new("Frame",{Parent=Window})
local Surface = Instance.new("FrameSurface",{Parent=Root})
local Pixels = buffer.create(16)
local Channel = Presentation.New()
local Old = Channel:Attach(Surface,2,2)
local New = Channel:Attach(Surface,2,2)
assert(not Channel:Detach(Old))
local Accepted, Reason = Channel:Submit(Old,1,Pixels,8,"BGRA8Premultiplied")
assert(not Accepted and Reason=="RetiredAttachment")
local Submitted, Unavailable = Channel:Submit(New,1,Pixels,8,"BGRA8Premultiplied")
assert(Submitted or Unavailable=="Unsupported")
if Submitted then
    assert(not Channel:Submit(New,1,Pixels,8,"BGRA8Premultiplied"))
    assert(Channel:Submit(New,2,Pixels,8,"BGRA8Premultiplied"))
end
assert(Channel:Detach(New))
assert(not Channel:Detach(New))
local Last = Channel:Attach(Surface,1,1)
Surface:Destroy()
assert(not Channel:Submit(Last,3,Pixels,8,"BGRA8Premultiplied"))
Channel:Destroy()
Channel:Destroy()
assert(not pcall(function() Channel:Attach(Surface,1,1) end))
Window:Destroy()
