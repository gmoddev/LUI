--!strict
local Documents = require('@LuiWorkbench/Documents')
local Store = Documents.New()
local First = Store:Open('One', 'One.luau', 'original')
assert(not First.Dirty and First.Revision == 1)
assert(Store:Open('One', 'Ignored duplicate', 'must not replace').Text == 'original')
assert(not pcall(function() (First :: any).Text = 'mutation' end))
Store:SetText('One', 'edit')
local Receipt = Store:BeginSave('One')
assert(Receipt.Text == 'edit' and Receipt.Revision == 2)
assert(not pcall(function() Store:BeginSave('One') end))
Store:SetText('One', 'later edit')
local Closed, Reason = Store:Close('One', true)
assert(not Closed and Reason == 'SavePending')
assert(Store:CompleteSave(Receipt, true))
local Current = Store:Get('One')
assert(Current and Current.Dirty and Current.Text == 'later edit')
assert(not Store:CompleteSave(Receipt, true))
Store:SetText('One', 'edit')
assert(not (Store:Get('One') :: any).Dirty)
Store:SetText('One', 'unsaved')
Closed, Reason = Store:Close('One'); assert(not Closed and Reason == 'Dirty')
local Failed = Store:BeginSave('One')
assert(not Store:CompleteSave(Failed, false) and (Store:Get('One') :: any).Dirty)
local Canceled = Store:BeginSave('One')
assert(Store:CancelSave(Canceled) and not Store:CancelSave(Canceled))
assert(Store:Close('One', true))
Store:Open('One', 'Reopened', 'new identity')
assert(not Store:CompleteSave(Canceled, true))
assert(not Store:CompleteSave({Id = 'One', Revision = 1, Text = 'forged'}, true))
Store:Open('Two', 'Two', '')
Store:Move('Two', 1)
assert(Store:List()[1].Id == 'Two')
assert(not pcall(function() Store:SetText('One', string.rep('a', 65535)) end))
assert(not pcall(function() Store:SetText('One', '\255') end))
assert(not pcall(function() Store:Move('Two', 0 / 0) end))
for Index = 3, 32 do Store:Open(tostring(Index), 'Synthetic', '') end
assert(not pcall(function() Store:Open('Overflow', 'Overflow', '') end))
local Pending = Store:BeginSave('One')
Store:Dispose(); Store:Dispose()
assert(not Store:CompleteSave(Pending, true) and not Store:CancelSave(Pending))
assert(not pcall(function() Store:SetText('One', 'late') end))

local Loading = Documents.New()
Loading:Open('One', 'Original label', 'default')
Loading:Open('Two', 'Second', '')
local Read = Loading:BeginLoad('One')
assert(not pcall(function() Loading:BeginLoad('One') end))
assert(Loading:CompleteLoad(Read, 'loaded'))
assert(Loading:List()[1].Id == 'One')
local Loaded = Loading:Get('One') :: Documents.Document
assert(Loaded.Text == 'loaded' and Loaded.Label == 'Original label' and not Loaded.Dirty and Loaded.Revision == 2)
assert(not Loading:CompleteLoad(Read, 'replay'))
assert(not Loading:CompleteLoad({Id = 'One', Revision = 2}, 'forged'))
Read = Loading:BeginLoad('One')
Loading:SetText('One', 'edit'); Loading:SetText('One', 'loaded')
assert(not Loading:CompleteLoad(Read, 'late read'))
assert((Loading:Get('One') :: Documents.Document).Text == 'loaded')
Read = Loading:BeginLoad('One')
local Write = Loading:BeginSave('One')
assert(not pcall(function() Loading:BeginLoad('One') end))
assert(not Loading:CompleteLoad(Read, 'read overtaken by save'))
assert(Loading:CancelSave(Write))
Read = Loading:BeginLoad('One')
assert(Loading:CancelLoad(Read) and not Loading:CancelLoad(Read))
assert(not Loading:CompleteLoad(Read, 'canceled'))
Read = Loading:BeginLoad('One')
assert(Loading:Close('One'))
Loading:Open('One', 'New identity', 'replacement')
assert(not Loading:CompleteLoad(Read, 'old identity'))
for _, Invalid in {'\255', '\0', string.rep('a', 65535)} do
    Read = Loading:BeginLoad('One')
    local Applied, Failure = Loading:CompleteLoad(Read, Invalid)
    assert(not Applied and Failure == 'InvalidText')
    assert((Loading:Get('One') :: Documents.Document).Text == 'replacement')
end
Read = Loading:BeginLoad('One')
local Applied, Failure = Loading:CompleteLoad(Read, nil)
assert(not Applied and Failure == 'Failed')
Read = Loading:BeginLoad('Two')
assert(Loading:CompleteLoad(Read, '') and not (Loading:Get('Two') :: Documents.Document).Dirty)
Loading:SetText('One', 'unsaved')
assert(not pcall(function() Loading:BeginLoad('One') end))
Loading:SetText('One', 'replacement')
Read = Loading:BeginLoad('One')
Loading:Dispose(); Loading:Dispose()
assert(not Loading:CompleteLoad(Read, 'retired') and not Loading:CancelLoad(Read))
print('[LUI:LibraryTest] Documents: dirty state, exact save receipts, stale identity, disposal and bounds passed')
