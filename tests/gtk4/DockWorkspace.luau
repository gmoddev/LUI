--!strict
-- Native compositor smoke fixture. The runner records surfaces from WAYLAND_DEBUG.
local DockModel=require("@LuiWorkbench/DockModel")
local DockHost=require("@LuiWorkbench/DockHost")
local Window=Instance.new("Window",{Name="Acquisition",Title="Acquisition",Size=UDim2.fromOffset(700,480)})
local Root=Instance.new("Frame",{Parent=Window,Size=UDim2.fromScale(1,1)})
local Notes=Instance.new("TextBox",{Parent=Root,Text="retained notes",Multiline=true})
local Plot=Instance.new("Frame",{Parent=Root,BackgroundColor3=Color3.fromRGB(36,109,136)})
local Floats: {[string]: any}={}
local Available,Metrics=pcall(function() return (app :: any):GetService("DesktopWindowMetrics") end)
local Host=DockHost.New(DockModel.New(),{Window=Window,Root=Root,OnWindow=function(Id,W,Added)
    Floats[Id]=if Added then W else nil
    if Added and Available and Metrics then
        task.defer(function()
            assert(Metrics:At(0,0)==0 and Metrics:Place(Id,10,10,300,280)==0)
            assert(Metrics:Own(Id,Window.Name)==1)
            assert(Metrics:Own(Window.Name,Id)==0 and Metrics:Own(Id,Id)==0 and Metrics:Own("Unknown",Id)==0)
            print("[LUI:DockQualification] NativeOwned")
        end)
    end
end})
assert(Host:Register("Editor",{Title="Notes",Content=Notes,Focus=Notes}))
assert(Host:Register("Plot",{Title="Signal",Content=Plot}))
assert(Host:Show("Editor") and Host:Show("Plot"))
local MainGroup=Host:GetLocation("Editor")
assert(Host:Move("Editor","Main",MainGroup,"Right"))
Window.Visible=true
task.delay(1,function()
    assert(Host:Float("Editor"))
    Notes.Text="edited in float"
    print("[LUI:DockQualification] Float")
end)
task.delay(2,function()
    local _,W=Host:GetLocation("Editor")
    assert(W and Floats[W])
    Floats[W].Size=UDim2.fromOffset(620,432)
    assert(Notes:Focus())
    print("[LUI:DockQualification] Resize")
end)
task.delay(3,function()
    local _,W=Host:GetLocation("Editor")
    assert(W and Host:Redock(W) and Notes.Text=="edited in float")
    assert(#Host:Snapshot().Floats==0)
    print("[LUI:DockQualification] Redock")
end)
task.delay(4,function()
    Host:Dispose()
    assert(Notes.Parent==Root and Notes.Text=="edited in float")
    Window:RequestClose()
    print("[LUI:DockQualification] Finished")
end)
